{
  "name": "skill-tech-resume-generator",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Agent skill that generates optimized one-page tech resumes from user-provided career data",
  "scripts": {
    "generate-resume": "node skills/tech-resume-generator/scripts/generate_resume_pdf.mjs",
    "extract-user-data": "python3 skills/tech-resume-generator/scripts/extract_user_data.py",
    "eval:grade": "python3 skills/tech-resume-generator/scripts/eval_grade.py --evals skills/tech-resume-generator/evals/evals.json",
    "eval:aggregate": "python3 skills/tech-resume-generator/scripts/eval_aggregate.py",
    "download-samples": "python3 skills/tech-resume-generator/scripts/download_sample_resumes.py",
    "postinstall": "npm --prefix skills/tech-resume-generator install --no-fund --no-audit",
    "skills:discover": "node skills_client/cli.mjs discover",
    "skills:catalog": "node skills_client/cli.mjs catalog",
    "skills:activate": "node skills_client/cli.mjs activate",
    "skills:slash": "node skills_client/cli.mjs slash"
  },
  "skills": [
    "./skills/tech-resume-generator"
  ],
  "files": [
    "skills/",
    "plugins/",
    ".claude-plugin/",
    "skills_client/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "package.json"
  ]
}
